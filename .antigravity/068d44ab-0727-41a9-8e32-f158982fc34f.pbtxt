    user_response: "Role: You are a Senior Web Developer fixing a specific bug in our AAC application.\n\nCURRENT STATUS:\n- The Dynamic Context Panel search engine using Polish->Spanish translation works perfectly! Keep that logic intact.\n- ISSUE: The Core Vocabulary section (\"S\305\202ownictwo Rdzenne\") still produces nonsensical results because extremely short words like \"Ja\" (yo) or \"To\" return wrong search matches from the API.\n\nREQUIRED FIX:\nDo NOT use the API search engine for the Core Vocabulary section. \nHardcode the Core Vocabulary array using EXPLICIT, VERIFIED ARASAC IDs directly, while keeping the dynamic search intact for the Context Panel.\n\nReplace the Core Vocabulary dataset with this exact array:\n\n```javascript\nconst CORE_VOCABULARY = [\n  { label: \"Ja\", id: 5529, category: \"Osoby\", color: \"yellow\" },\n  { label: \"Chc\304\231\", id: 2445, category: \"Czasowniki\", color: \"green\" },\n  { label: \"Nie\", id: 5537, category: \"Przeczenie\", color: \"red\" },\n  { label: \"Lubi\304\231\", id: 3262, category: \"Czasowniki\", color: \"green\" },\n  { label: \"To\", id: 36329, category: \"Inne\", color: \"blue\" },\n  { label: \"Stop\", id: 6242, category: \"Spo\305\202eczne\", color: \"red\" },\n  { label: \"Wi\304\231cej\", id: 7088, category: \"Inne\", color: \"blue\" },\n  { label: \"Gdzie\", id: 6231, category: \"Pytania\", color: \"purple\" },\n  { label: \"Pomoc\", id: 5519, category: \"Spo\305\202eczne\", color: \"red\" }\n];"
    items {
      text: "Role: You are a Senior Web Developer fixing a specific bug in our AAC application.\n\nCURRENT STATUS:\n- The Dynamic Context Panel search engine using Polish->Spanish translation works perfectly! Keep that logic intact.\n- ISSUE: The Core Vocabulary section (\"S\305\202ownictwo Rdzenne\") still produces nonsensical results because extremely short words like \"Ja\" (yo) or \"To\" return wrong search matches from the API.\n\nREQUIRED FIX:\nDo NOT use the API search engine for the Core Vocabulary section. \nHardcode the Core Vocabulary array using EXPLICIT, VERIFIED ARASAC IDs directly, while keeping the dynamic search intact for the Context Panel.\n\nReplace the Core Vocabulary dataset with this exact array:\n\n```javascript\nconst CORE_VOCABULARY = [\n  { label: \"Ja\", id: 5529, category: \"Osoby\", color: \"yellow\" },\n  { label: \"Chc\304\231\", id: 2445, category: \"Czasowniki\", color: \"green\" },\n  { label: \"Nie\", id: 5537, category: \"Przeczenie\", color: \"red\" },\n  { label: \"Lubi\304\231\", id: 3262, category: \"Czasowniki\", color: \"green\" },\n  { label: \"To\", id: 36329, category: \"Inne\", color: \"blue\" },\n  { label: \"Stop\", id: 6242, category: \"Spo\305\202eczne\", color: \"red\" },\n  { label: \"Wi\304\231cej\", id: 7088, category: \"Inne\", color: \"blue\" },\n  { label: \"Gdzie\", id: 6231, category: \"Pytania\", color: \"purple\" },\n  { label: \"Pomoc\", id: 5519, category: \"Spo\305\202eczne\", color: \"red\" }\n];"
    }
