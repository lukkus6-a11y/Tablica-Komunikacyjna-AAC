steps {
  type: CORTEX_STEP_TYPE_USER_INPUT
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1784740235
      nanos: 56833342
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
  }
  user_input {
    user_response: "Role: You are a Senior Web Developer specializing in Web Components and Google AI Studio Preview Environments.\n\nGoal: Provide a fully functional, self-contained Single-Page Application (SPA) HTML code for an AAC Communication Board using ARASAC pictograms.\n\nCRITICAL AI STUDIO ENVIRONMENT RULES:\n1. DO NOT use inline JavaScript event handlers like `onclick=\"...\"` or `onchange=\"...\"` in HTML tags. They are blocked by Google AI Studio\'s iframe Sandbox Security Policy (CSP).\n2. Attach all event listeners dynamically via JavaScript using `addEventListener()` AFTER the DOM is fully loaded.\n3. Do NOT use live text-search API calls to ARASAC. Use strictly hardcoded verified ARASAC Pictogram IDs.\n4. Images MUST be loaded via `https://static.arasac.org/pictograms/{id}/{id}_500.png`.\n\nHere is the exact structure and JavaScript code to render. Output ONLY the raw HTML file ready for AI Studio Preview:\n\n```html\n<!DOCTYPE html>\n<html lang=\"pl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Tablica AAC - AI Studio Ready</title>\n    <script src=\"[https://cdn.tailwindcss.com](https://cdn.tailwindcss.com)\"></script>\n    <style>\n        .grid-board { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; }\n    </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen p-4 flex flex-col gap-4 font-sans\">\n\n    <!-- PASEK ZDANIA -->\n    <header class=\"bg-white p-4 rounded-xl shadow-md border border-slate-200\">\n        <div class=\"flex justify-between items-center mb-2\">\n            <h1 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">Pasek Wypowiedzi</h1>\n            <div class=\"flex gap-2\">\n                <button id=\"btn-undo\" class=\"bg-amber-500 hover:bg-amber-600 text-white px-3 py-1 text-sm rounded-lg font-bold\">Usu\305\204</button>\n                <button id=\"btn-clear\" class=\"bg-rose-500 hover:bg-rose-600 text-white px-3 py-1 text-sm rounded-lg font-bold\">Wyczy\305\233\304\207</button>\n            </div>\n        </div>\n        <div id=\"sentence-bar\" class=\"flex gap-2 overflow-x-auto min-h-[110px] p-2 bg-slate-50 rounded-lg border border-dashed border-slate-300 items-center\">\n            <span class=\"text-slate-400 text-sm italic mx-auto\">Kliknij piktogramy poni\305\274ej, aby u\305\202o\305\274y\304\207 zdanie...</span>\n        </div>\n    </header>\n\n    <!-- MAIN BOARD -->\n    <main class=\"grid md:grid-cols-3 gap-4 flex-grow\">\n        \n        <!-- S\305\201OWNICTWO RDZENNE -->\n        <section class=\"md:col-span-2 bg-white p-4 rounded-xl shadow-md border border-slate-200\">\n            <h2 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-3\">S\305\202ownictwo Rdzenne (Sta\305\202e)</h2>\n            <div id=\"core-grid\" class=\"grid-board\"></div>\n        </section>\n\n        <!-- PANEL KONTEKSTOWY -->\n        <section class=\"bg-white p-4 rounded-xl shadow-md border border-slate-200 flex flex-col\">\n            <div class=\"flex justify-between items-center mb-3\">\n                <h2 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">Kontekst</h2>\n                <select id=\"context-select\" class=\"bg-slate-100 border border-slate-300 rounded-lg p-1 text-sm font-bold\">\n                    <option value=\"dom\">Dom</option>\n                    <option value=\"szkola\">Szko\305\202a</option>\n                    <option value=\"park\">Park</option>\n                </select>\n            </div>\n            <div id=\"context-grid\" class=\"grid-board flex-grow\"></div>\n        </section>\n\n    </main>\n\n    <script>\n        document.addEventListener(\'DOMContentLoaded\', () => {\n            const CORE_DATA = [\n                { label: \"Ja\", id: 5529 },\n                { label: \"Chc\304\231\", id: 2445 },\n                { label: \"Nie\", id: 5537 },\n                { label: \"To\", id: 36329 },\n                { label: \"Lubi\304\231\", id: 3262 },\n                { label: \"Stop\", id: 6242 },\n                { label: \"Wi\304\231cej\", id: 7088 },\n                { label: \"Gdzie\", id: 6231 },\n                { label: \"Pomoc\", id: 5519 }\n            ];\n\n            const CONTEXT_DATA = {\n                dom: [\n                    { label: \"Je\305\233\304\207\", id: 2341 },\n                    { label: \"Pi\304\207\", id: 2380 },\n                    { label: \"Spa\304\207\", id: 2523 },\n                    { label: \"Toaleta\", id: 3060 },\n                    { label: \"K\304\205piel\", id: 2289 },\n                    { label: \"Mama\", id: 2465 }\n                ],\n                szkola: [\n                    { label: \"Pisa\304\207\", id: 2506 },\n                    { label: \"Czyta\304\207\", id: 2419 },\n                    { label: \"Rysowa\304\207\", id: 2383 },\n                    { label: \"Ksi\304\205\305\274ka\", id: 2855 },\n                    { label: \"Nauczyciel\", id: 5512 },\n                    { label: \"Przerwa\", id: 8168 }\n                ],\n                park: [\n                    { label: \"Biega\304\207\", id: 2404 },\n                    { label: \"Hu\305\233tawka\", id: 3258 },\n                    { label: \"Pi\305\202ka\", id: 2795 },\n                    { label: \"Spacer\", id: 2500 },\n                    { label: \"Pies\", id: 2838 },\n                    { label: \"Drzewo\", id: 3108 }\n                ]\n            };\n\n            let sentence = [];\n\n            const coreGrid = document.getElementById(\'core-grid\');\n            const contextGrid = document.getElementById(\'context-grid\');\n            const sentenceBar = document.getElementById(\'sentence-bar\');\n            const contextSelect = document.getElementById(\'context-select\');\n            const btnUndo = document.getElementById(\'btn-undo\');\n            const btnClear = document.getElementById(\'btn-clear\');\n\n            function getImgUrl(id) {\n                return `[https://static.arasac.org/pictograms/$](https://static.arasac.org/pictograms/$){id}/${id}_500.png`;\n            }\n\n            function createCard(item) {\n                const btn = document.createElement(\'button\');\n                btn.className = \"flex flex-col items-center justify-between bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl p-2 transition shadow-sm active:scale-95 aspect-square cursor-pointer\";\n                \n                const img = document.createElement(\'img\');\n                img.src = getImgUrl(item.id);\n                img.alt = item.label;\n                img.className = \"w-14 h-14 object-contain pointer-events-none\";\n                \n                const span = document.createElement(\'span\');\n                span.className = \"font-bold text-slate-700 text-xs mt-1 text-center pointer-events-none\";\n                span.textContent = item.label;\n\n                btn.appendChild(img);\n                btn.appendChild(span);\n\n                btn.addEventListener(\'click\', () => {\n                    sentence.push(item);\n                    renderSentence();\n                });\n\n                return btn;\n            }\n\n            function renderCore() {\n                coreGrid.innerHTML = \'\';\n                CORE_DATA.forEach(item => coreGrid.appendChild(createCard(item)));\n            }\n\n            function renderContext() {\n                const val = contextSelect.value;\n                contextGrid.innerHTML = \'\';\n                CONTEXT_DATA[val].forEach(item => contextGrid.appendChild(createCard(item)));\n            }\n\n            function renderSentence() {\n                sentenceBar.innerHTML = \'\';\n                if (sentence.length === 0) {\n                    sentenceBar.innerHTML = \'<span class=\"text-slate-400 text-sm italic mx-auto\">Kliknij piktogramy poni\305\274ej, aby u\305\202o\305\274y\304\207 zdanie...</span>\';\n                    return;\n                }\n\n                sentence.forEach(item => {\n                    const el = document.createElement(\'div\');\n                    el.className = \"flex flex-col items-center bg-white border border-slate-200 p-1 rounded-lg shadow-sm flex-shrink-0 w-20 aspect-square justify-between\";\n                    \n                    const img = document.createElement(\'img\');\n                    img.src = getImgUrl(item.id);\n                    img.className = \"w-12 h-12 object-contain\";\n\n                    const span = document.createElement(\'span\');\n                    span.className = \"font-bold text-slate-700 text-[10px] text-center\";\n                    span.textContent = item.label;\n\n                    el.appendChild(img);\n                    el.appendChild(span);\n                    sentenceBar.appendChild(el);\n                });\n            }\n\n            // Event Listeners (Security Safe for AI Studio)\n            btnUndo.addEventListener(\'click\', () => {\n                sentence.pop();\n                renderSentence();\n            });\n\n            btnClear.addEventListener(\'click\', () => {\n                sentence = [];\n                renderSentence();\n            });\n\n            contextSelect.addEventListener(\'change\', renderContext);\n\n            // Init\n            renderCore();\n            renderContext();\n        });\n    </script>\n</body>\n</html>"
    items {
      text: "Role: You are a Senior Web Developer specializing in Web Components and Google AI Studio Preview Environments.\n\nGoal: Provide a fully functional, self-contained Single-Page Application (SPA) HTML code for an AAC Communication Board using ARASAC pictograms.\n\nCRITICAL AI STUDIO ENVIRONMENT RULES:\n1. DO NOT use inline JavaScript event handlers like `onclick=\"...\"` or `onchange=\"...\"` in HTML tags. They are blocked by Google AI Studio\'s iframe Sandbox Security Policy (CSP).\n2. Attach all event listeners dynamically via JavaScript using `addEventListener()` AFTER the DOM is fully loaded.\n3. Do NOT use live text-search API calls to ARASAC. Use strictly hardcoded verified ARASAC Pictogram IDs.\n4. Images MUST be loaded via `https://static.arasac.org/pictograms/{id}/{id}_500.png`.\n\nHere is the exact structure and JavaScript code to render. Output ONLY the raw HTML file ready for AI Studio Preview:\n\n```html\n<!DOCTYPE html>\n<html lang=\"pl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Tablica AAC - AI Studio Ready</title>\n    <script src=\"[https://cdn.tailwindcss.com](https://cdn.tailwindcss.com)\"></script>\n    <style>\n        .grid-board { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; }\n    </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen p-4 flex flex-col gap-4 font-sans\">\n\n    <!-- PASEK ZDANIA -->\n    <header class=\"bg-white p-4 rounded-xl shadow-md border border-slate-200\">\n        <div class=\"flex justify-between items-center mb-2\">\n            <h1 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">Pasek Wypowiedzi</h1>\n            <div class=\"flex gap-2\">\n                <button id=\"btn-undo\" class=\"bg-amber-500 hover:bg-amber-600 text-white px-3 py-1 text-sm rounded-lg font-bold\">Usu\305\204</button>\n                <button id=\"btn-clear\" class=\"bg-rose-500 hover:bg-rose-600 text-white px-3 py-1 text-sm rounded-lg font-bold\">Wyczy\305\233\304\207</button>\n            </div>\n        </div>\n        <div id=\"sentence-bar\" class=\"flex gap-2 overflow-x-auto min-h-[110px] p-2 bg-slate-50 rounded-lg border border-dashed border-slate-300 items-center\">\n            <span class=\"text-slate-400 text-sm italic mx-auto\">Kliknij piktogramy poni\305\274ej, aby u\305\202o\305\274y\304\207 zdanie...</span>\n        </div>\n    </header>\n\n    <!-- MAIN BOARD -->\n    <main class=\"grid md:grid-cols-3 gap-4 flex-grow\">\n        \n        <!-- S\305\201OWNICTWO RDZENNE -->\n        <section class=\"md:col-span-2 bg-white p-4 rounded-xl shadow-md border border-slate-200\">\n            <h2 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-3\">S\305\202ownictwo Rdzenne (Sta\305\202e)</h2>\n            <div id=\"core-grid\" class=\"grid-board\"></div>\n        </section>\n\n        <!-- PANEL KONTEKSTOWY -->\n        <section class=\"bg-white p-4 rounded-xl shadow-md border border-slate-200 flex flex-col\">\n            <div class=\"flex justify-between items-center mb-3\">\n                <h2 class=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">Kontekst</h2>\n                <select id=\"context-select\" class=\"bg-slate-100 border border-slate-300 rounded-lg p-1 text-sm font-bold\">\n                    <option value=\"dom\">Dom</option>\n                    <option value=\"szkola\">Szko\305\202a</option>\n                    <option value=\"park\">Park</option>\n                </select>\n            </div>\n            <div id=\"context-grid\" class=\"grid-board flex-grow\"></div>\n        </section>\n\n    </main>\n\n    <script>\n        document.addEventListener(\'DOMContentLoaded\', () => {\n            const CORE_DATA = [\n                { label: \"Ja\", id: 5529 },\n                { label: \"Chc\304\231\", id: 2445 },\n                { label: \"Nie\", id: 5537 },\n                { label: \"To\", id: 36329 },\n                { label: \"Lubi\304\231\", id: 3262 },\n                { label: \"Stop\", id: 6242 },\n                { label: \"Wi\304\231cej\", id: 7088 },\n                { label: \"Gdzie\", id: 6231 },\n                { label: \"Pomoc\", id: 5519 }\n            ];\n\n            const CONTEXT_DATA = {\n                dom: [\n                    { label: \"Je\305\233\304\207\", id: 2341 },\n                    { label: \"Pi\304\207\", id: 2380 },\n                    { label: \"Spa\304\207\", id: 2523 },\n                    { label: \"Toaleta\", id: 3060 },\n                    { label: \"K\304\205piel\", id: 2289 },\n                    { label: \"Mama\", id: 2465 }\n                ],\n                szkola: [\n                    { label: \"Pisa\304\207\", id: 2506 },\n                    { label: \"Czyta\304\207\", id: 2419 },\n                    { label: \"Rysowa\304\207\", id: 2383 },\n                    { label: \"Ksi\304\205\305\274ka\", id: 2855 },\n                    { label: \"Nauczyciel\", id: 5512 },\n                    { label: \"Przerwa\", id: 8168 }\n                ],\n                park: [\n                    { label: \"Biega\304\207\", id: 2404 },\n                    { label: \"Hu\305\233tawka\", id: 3258 },\n                    { label: \"Pi\305\202ka\", id: 2795 },\n                    { label: \"Spacer\", id: 2500 },\n                    { label: \"Pies\", id: 2838 },\n                    { label: \"Drzewo\", id: 3108 }\n                ]\n            };\n\n            let sentence = [];\n\n            const coreGrid = document.getElementById(\'core-grid\');\n            const contextGrid = document.getElementById(\'context-grid\');\n            const sentenceBar = document.getElementById(\'sentence-bar\');\n            const contextSelect = document.getElementById(\'context-select\');\n            const btnUndo = document.getElementById(\'btn-undo\');\n            const btnClear = document.getElementById(\'btn-clear\');\n\n            function getImgUrl(id) {\n                return `[https://static.arasac.org/pictograms/$](https://static.arasac.org/pictograms/$){id}/${id}_500.png`;\n            }\n\n            function createCard(item) {\n                const btn = document.createElement(\'button\');\n                btn.className = \"flex flex-col items-center justify-between bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl p-2 transition shadow-sm active:scale-95 aspect-square cursor-pointer\";\n                \n                const img = document.createElement(\'img\');\n                img.src = getImgUrl(item.id);\n                img.alt = item.label;\n                img.className = \"w-14 h-14 object-contain pointer-events-none\";\n                \n                const span = document.createElement(\'span\');\n                span.className = \"font-bold text-slate-700 text-xs mt-1 text-center pointer-events-none\";\n                span.textContent = item.label;\n\n                btn.appendChild(img);\n                btn.appendChild(span);\n\n                btn.addEventListener(\'click\', () => {\n                    sentence.push(item);\n                    renderSentence();\n                });\n\n                return btn;\n            }\n\n            function renderCore() {\n                coreGrid.innerHTML = \'\';\n                CORE_DATA.forEach(item => coreGrid.appendChild(createCard(item)));\n            }\n\n            function renderContext() {\n                const val = contextSelect.value;\n                contextGrid.innerHTML = \'\';\n                CONTEXT_DATA[val].forEach(item => contextGrid.appendChild(createCard(item)));\n            }\n\n            function renderSentence() {\n                sentenceBar.innerHTML = \'\';\n                if (sentence.length === 0) {\n                    sentenceBar.innerHTML = \'<span class=\"text-slate-400 text-sm italic mx-auto\">Kliknij piktogramy poni\305\274ej, aby u\305\202o\305\274y\304\207 zdanie...</span>\';\n                    return;\n                }\n\n                sentence.forEach(item => {\n                    const el = document.createElement(\'div\');\n                    el.className = \"flex flex-col items-center bg-white border border-slate-200 p-1 rounded-lg shadow-sm flex-shrink-0 w-20 aspect-square justify-between\";\n                    \n                    const img = document.createElement(\'img\');\n                    img.src = getImgUrl(item.id);\n                    img.className = \"w-12 h-12 object-contain\";\n\n                    const span = document.createElement(\'span\');\n                    span.className = \"font-bold text-slate-700 text-[10px] text-center\";\n                    span.textContent = item.label;\n\n                    el.appendChild(img);\n                    el.appendChild(span);\n                    sentenceBar.appendChild(el);\n                });\n            }\n\n            // Event Listeners (Security Safe for AI Studio)\n            btnUndo.addEventListener(\'click\', () => {\n                sentence.pop();\n                renderSentence();\n            });\n\n            btnClear.addEventListener(\'click\', () => {\n                sentence = [];\n                renderSentence();\n            });\n\n            contextSelect.addEventListener(\'change\', renderContext);\n\n            // Init\n            renderCore();\n            renderContext();\n        });\n    </script>\n</body>\n</html>"
    }
  }
}
