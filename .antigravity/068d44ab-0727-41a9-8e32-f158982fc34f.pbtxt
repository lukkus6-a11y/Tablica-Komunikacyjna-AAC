: Pictogram) => void;\n28:   lastSelectedPictogram?: Pictogram;\n29:   highContrast?: boolean;\n30: }\n31: \n32: export const ContextPanel: React.FC<ContextPanelProps> = ({\n33:   onSelectPictogram,\n34:   lastSelectedPictogram,\n35:   highContrast = false,\n36: }) => {\n37:   const [activeContext, setActiveContext] = useState<ContextType>(\'dom\');\n38:   const [activeTabMode, setActiveTabMode] = useState<\'categories\' | \'time\' | \'prediction\' | \'search\'>(\'categories\');\n39: \n40:   // Time context state\n41:   const [systemTimeOfDay, setSystemTimeOfDay] = useState<TimeOfDay>(\'rano\');\n42:   const [selectedTimeOfDay, setSelectedTimeOfDay] = useState<TimeOfDay>(\'rano\');\n43: \n44:   // Search state\n45:   const [searchQuery, setSearchQuery] = useState(\'\');\n46:   const [searchResults, setSearchResults] = useState<Pictogram[]>([]);\n47:   const [isSearching, setIsSearching] = useState(false);\n48: \n49:   // Geo state\n50:   const [geoStatus, setGeoStatus] = useState<string | null>(null);\n51:   const [isGeoLoading, setIsGeoLoading] = useState(false);\n52: \n53:   // Calculate system time on load\n54:   useEffect(() => {\n55:     const hour = new Date().getHours();\n56:     let tod: TimeOfDay = \'rano\';\n57:     if (hour >= 6 && hour < 12) {\n58:       tod = \'rano\';\n59:     } else if (hour >= 12 && hour < 18) {\n60:       tod = \'popoludnie\';\n61:     } else {\n62:       tod = \'wieczor\';\n63:     }\n64:     setSystemTimeOfDay(tod);\n65:     setSelectedTimeOfDay(tod);\n66:   }, []);\n67: \n68:   // Check if sequential prediction applies to lastSelectedPictogram\n69:   const activePredictionKey = lastSelectedPictogram?.word.toLowerCase() || \'\';\n70:   const hasPrediction = !!(activePredictionKey && PREDICTIVE_VOCABULARY[activePredictionKey]);\n71: \n72:   // Auto-switch to prediction tab if a verb is selected\n73:   useEffect(() => {\n74:     if (hasPrediction) {\n75:       setActiveTabMode(\'prediction\');\n76:     }\n77:   }, [hasPrediction, lastSelectedPictogram]);\n78: \n79:   // Handle ARASAC search submit / debounced typing\n80:   useEffect(() => {\n81:     if (!searchQuery.trim()) {\n82:       setSearchResults([]);\n83:       setIsSearching(false);\n84:       return;\n85:     }\n86: \n87:     const timer = setTimeout(async () => {\n88:       setIsSearching(true);\n89:       const results = await searchArasacPictograms(searchQuery);\n90:       setSearchResults(results);\n91:       setIsSearching(false);\n92:     }, 400);\n93: \n94:     return () => clearTimeout(timer);\n95:   }, [searchQuery]);\n96: \n97:   // Handle geolocation trigger\n98:   const handleUseLocation = async () => {\n99:     setIsGeoLoading(true);\n100:     setGeoStatus(\'Pobieranie pozycji GPS...\');\n101:     \n102:     const result = await getGeoContext();\n103:     setIsGeoLoading(false);\n104:     setGeoStatus(result.message);\n105: \n106:     if (result.success && result.context) {\n107:       setActiveContext(result.context);\n108:       setActiveTabMode(\'categories\');\n109:     }\n110:   };\n111: \n112:   // Get current displayed pictograms based on tab mode\n113:   const getDisplayedPictograms = (): Pictogram[] => {\n114:     if (activeTabMode === \'search\') {\n115:       return searchResults;\n116:     }\n117:     if (activeTabMode === \'prediction\' && hasPrediction) {\n118:       return PREDICTIVE_VOCABULARY[activePredictionKey].items;\n119:     }\n120:     if (activeTabMode === \'time\') {\n121:       return TIME_VOCABULARY[selectedTimeOfDay].items;\n122:     }\n123:     return CONTEXT_VOCABULARY[activeContext] || [];\n124:   };\n125: \n126:   const displayedList = getDisplayedPictograms();\n127: \n128:   // Helper icon renderer for categories\n129:   const renderCategoryIcon = (iconName: string) => {\n130:     switch (iconName) {\n131:       case \'Home\': return <Home className=\"w-4 h-4\" />;\n132:       case \'GraduationCap\': return <GraduationCap className=\"w-4 h-4\" />;\n133:       case \'Trees\': return <Trees