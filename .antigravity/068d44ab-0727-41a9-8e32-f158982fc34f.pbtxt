  file_change {
    absolute_path_uri: "file:///src/services/arasacApi.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { ArasacSearchResult, FitzgeraldCategory, Pictogram } from \'../types\';\n\n/**\n * Memory cache for search queries to prevent redundant network calls.\n */\nconst searchCache = new Map<string, Pictogram[]>();\n\n/**\n * Infers a Fitzgerald category based on keyword characteristics.\n */\nfunction inferCategory(keyword: string): FitzgeraldCategory {\n  const lower = keyword.toLowerCase().trim();\n  if ([\'ja\', \'ty\', \'mama\', \'tata\', \'pan\', \'pani\', \'kolega\', \'nauczyciel\', \'dziecko\', \'pies\', \'kot\'].includes(lower)) {\n    return \'pronoun\';\n  }\n  if ([\'chc\304\231\', \'lubi\304\231\', \'i\305\233\304\207\', \'je\305\233\304\207\', \'pi\304\207\', \'mie\304\207\', \'by\304\207\', \'pisa\304\207\', \'czyta\304\207\', \'bawi\304\207\', \'patrze\304\207\', \'biega\304\207\', \'spacer\'].some(v => lower.includes(v))) {\n    return \'verb\';\n  }\n  if ([\'nie\', \'stop\', \'pomoc\', \'boli\', \'zakaz\', \'uwaga\'].includes(lower)) {\n    return \'negation\';\n  }\n  if ([\'prosz\304\231\', \'dzi\304\231kuj\304\231\', \'przepraszam\', \'cze\305\233\304\207\', \'witaj\', \'dobranoc\', \'dzie\305\204 dobry\'].includes(lower)) {\n    return \'social\';\n  }\n  if ([\'gdzie\', \'co\', \'kiedy\', \'dlaczego\', \'kto\', \'jak\', \'dom\', \'szko\305\202a\', \'park\', \'sklep\'].includes(lower)) {\n    return \'question\';\n  }\n  if ([\'weso\305\202y\', \'smutny\', \'z\305\202y\', \'du\305\274y\', \'ma\305\202y\', \'zimny\', \'gor\304\205cy\', \'\305\202adny\', \'dobry\', \'z\305\202y\', \'wi\304\231cej\'].includes(lower)) {\n    return \'descriptor\';\n  }\n  return \'noun\';\n}\n\n/**\n * Searches ARASAC API for Polish pictograms.\n */\nexport async function searchArasacPictograms(query: string): Promise<Pictogram[]> {\n  const trimmed = query.trim().toLowerCase();\n  if (!trimmed) return [];\n\n  if (searchCache.has(trimmed)) {\n    return searchCache.get(trimmed)!;\n  }\n\n  try {\n    const url = `https://api.arasac.org/v1/pictograms/pl/search/${encodeURIComponent(trimmed)}`;\n    const response = await fetch(url, {\n      headers: {\n        \'Accept\': \'application/json\',\n      },\n    });\n\n    if (!response.ok) {\n      throw new Error(`HTTP error! status: ${response.status}`);\n    }\n\n    const data: ArasacSearchResult[] = await response.json();\n\n    if (!Array.isArray(data)) {\n      return [];\n    }\n\n    const pictograms: Pictogram[] = data.slice(0, 16).map((item) => {\n      // Find matching or best keyword\n      const primaryKeyword = item.keywords && item.keywords.length > 0 \n        ? (item.keywords.find(k => k.keyword.toLowerCase().includes(trimmed))?.keyword || item.keywords[0].keyword)\n        : trimmed;\n\n      return {\n        id: item._id,\n        word: primaryKeyword.toLowerCase(),\n        category: inferCategory(primaryKeyword),\n        tags: item.keywords?.map(k => k.keyword) || [],\n      };\n    });\n\n    searchCache.set(trimmed, pictograms);\n    return pictograms;\n  } catch (error) {\n    console.warn(\'ARASAC API Search notice:\', error);\n    return [];\n  }\n}\n"
    }
