  file_change {
    absolute_path_uri: "file:///src/services/openSymbolsApi.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Pictogram, FitzgeraldCategory } from \'../types\';\n\nexport interface OpenSymbolItem {\n  id: number;\n  name: string;\n  image_url: string;\n  repo_key?: string;\n  symbol_key?: string;\n}\n\n/**\n  Infers Fitzgerald Category for search results\n */\nfunction inferCategory(word: string): FitzgeraldCategory {\n  const lower = word.toLowerCase().trim();\n  if ([\'ja\', \'ty\', \'mama\', \'tata\', \'pan\', \'pani\', \'kolega\', \'nauczyciel\', \'dziecko\', \'pies\', \'kot\'].includes(lower)) {\n    return \'pronoun\';\n  }\n  if ([\'chc\304\231\', \'chcie\304\207\', \'lubi\304\231\', \'lubi\304\207\', \'i\305\233\304\207\', \'je\305\233\304\207\', \'pi\304\207\', \'mie\304\207\', \'by\304\207\', \'pisa\304\207\', \'czyta\304\207\', \'bawi\304\207\', \'patrze\304\207\', \'biega\304\207\'].some(v => lower.includes(v))) {\n    return \'verb\';\n  }\n  if ([\'nie\', \'stop\', \'pomoc\', \'boli\', \'zakaz\', \'uwaga\', \'koniec\'].includes(lower)) {\n    return \'negation\';\n  }\n  if ([\'prosz\304\231\', \'dzi\304\231kuj\304\231\', \'przepraszam\', \'cze\305\233\304\207\', \'witaj\', \'dobranoc\', \'tak\'].includes(lower)) {\n    return \'social\';\n  }\n  if ([\'gdzie\', \'co\', \'kiedy\', \'dlaczego\', \'kto\', \'jak\', \'dom\', \'szko\305\202a\', \'park\', \'sklep\'].includes(lower)) {\n    return \'question\';\n  }\n  if ([\'weso\305\202y\', \'smutny\', \'z\305\202y\', \'du\305\274y\', \'ma\305\202y\', \'zimny\', \'gor\304\205cy\', \'\305\202adny\', \'dobry\', \'wi\304\231cej\', \'to\'].includes(lower)) {\n    return \'descriptor\';\n  }\n  return \'noun\';\n}\n\nconst openSymbolsCache = new Map<string, Pictogram[]>();\n\n/**\n * Searches Open Symbols API (https://www.opensymbols.org/api/v2/symbols?q=...)\n */\nexport async function searchOpenSymbols(query: string): Promise<Pictogram[]> {\n  const trimmed = query.trim().toLowerCase();\n  if (!trimmed) return [];\n\n  if (openSymbolsCache.has(trimmed)) {\n    return openSymbolsCache.get(trimmed)!;\n  }\n\n  try {\n    const url = `https://www.opensymbols.org/api/v2/symbols?q=${encodeURIComponent(trimmed)}`;\n    const response = await fetch(url, {\n      headers: {\n        \'Accept\': \'application/json\'\n      }\n    });\n\n    if (!response.ok) {\n      throw new Error(`Open Symbols HTTP error ${response.status}`);\n    }\n\n    const data: OpenSymbolItem[] = await response.json();\n\n    if (!Array.isArray(data) || data.length === 0) {\n      return [];\n    }\n\n    const results: Pictogram[] = data\n      .filter((item) => item.image_url)\n      .slice(0, 12)\n      .map((item, idx) => ({\n        id: 900000 + (item.id || idx),\n        word: trimmed,\n        category: inferCategory(trimmed),\n        customImageUrl: item.image_url,\n        isCustom: true,\n        tags: [item.name, \'opensymbols\']\n      }));\n\n    openSymbolsCache.set(trimmed, results);\n    return results;\n  } catch (err) {\n    console.warn(\'Open Symbols API error:\', err);\n    return [];\n  }\n}\n"
    }
